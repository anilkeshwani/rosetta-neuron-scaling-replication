+def _gemma3_text_only_loader(model_id: str, revision: Optional[str]):
+    """Gemma 3 at 4B and up is a Gemma3ForConditionalGeneration checkpoint
+    (vision tower + text decoder). Load only the decoder as Gemma3ForCausalLM, so
+    hooks, backbone forward and FSDP see the same model.model.layers layout as
+    the text-only 270M/1B checkpoints. Returns None for every other model.
+
+    No key mapping is needed: the checkpoint keys start with "language_model.",
+    which is Gemma3ForCausalLM.base_model_prefix, so transformers strips that
+    prefix and skips the vision_tower/multi_modal_projector keys."""
+    if "gemma" not in model_id.lower():
+        return None
+    from transformers import AutoConfig
+    config = AutoConfig.from_pretrained(model_id, revision=revision)
+    if config.model_type != "gemma3":
+        return None
+    from transformers import Gemma3ForCausalLM
+    return functools.partial(Gemma3ForCausalLM.from_pretrained, config=config.text_config)
+
